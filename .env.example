# PostgreSQL Connection URLs
# For local development (your Homebrew PostgreSQL)
DATABASE_URL=postgresql://writer:writer_password@localhost:5432/raven

# Read-only connection (for queries that shouldn't modify data)
DATABASE_URL_READONLY=postgresql://reader:reader_password@localhost:5432/raven

# Admin connection (for migrations)
DATABASE_URL_ADMIN=postgresql://sujalnath@localhost:5432/raven
